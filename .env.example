# === Django Core ===
SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,web

# === URLs ===
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:8080

# === Celery & Redis ===
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false
LAUNCH_IMMEDIATE_PASSES=1

# === Database (Optional; defaults to SQLite if unset) ===
# DATABASE_URL=postgres://leadorbit:leadorbit@db:5432/leadorbit

# === AI Personalization (Optional) ===
AI_PROVIDER=none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=60
GEMINI_API_KEY=

# === Google OAuth (Optional) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# === Webhooks & Cron ===
WEBHOOK_SECRET=
CRON_SECRET=
ENABLE_AUTO_REPLY_DETECTION=false
ENABLE_AUTO_BOUNCE_DETECTION=true

# Copy to `.env` in the project root, fill in the blanks, then: docker compose up -d --build
# `.env` is git-ignored. Never commit real values.

# ── Public address ─────────────────────────────────────────────
# ":80" = plain HTTP for local testing. A domain (e.g. leadorbit.example.com) gets
# automatic HTTPS from Let's Encrypt; point its DNS at the server first.
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost
# Where tracking/unsubscribe links and OAuth redirects point. Use your PUBLIC_URL.
BACKEND_BASE_URL=http://localhost
FRONTEND_BASE_URL=http://localhost

# ── Secrets (generate each with: python -c "import secrets; print(secrets.token_urlsafe(50))") ──
SECRET_KEY=
MAILBOX_CREDENTIALS_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
# Email provider webhooks (opens/replies/bounces) must send this as X-Webhook-Secret.
WEBHOOK_SECRET=

# ── Database (Postgres container) ──────────────────────────────
POSTGRES_USER=leadorbit
POSTGRES_DB=leadorbit

# ── Self-hosted AI (Ollama container) ──────────────────────────
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b

# ── Hosting from your own PC via Cloudflare Tunnel (optional) ──
# Keep SITE_ADDRESS=:80 (Cloudflare provides HTTPS), set the URLs above to
# https://your-domain, then run: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# ── Optional integrations ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ENABLE_AUTO_REPLY_DETECTION=true
ENABLE_AUTO_BOUNCE_DETECTION=true

# === Django Core ===
SECRET_KEY=your-secret-key-here          # REQUIRED
DEBUG=True                                # Set to False in production
ALLOWED_HOSTS=localhost,127.0.0.1

# === Database ===
# DATABASE_URL=postgres://...            # Optional, defaults to SQLite

# === Google OAuth ===
GOOGLE_CLIENT_ID=                         # REQUIRED for Gmail integration
GOOGLE_CLIENT_SECRET=                     # REQUIRED for Gmail integration
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

# === Celery ===
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# === Free hosting (Render + Netlify) ===
CORS_ALLOWED_ORIGINS=                     # Frontend URL(s), e.g. https://leadorbit.netlify.app (empty = allow all, dev only)
CRON_SECRET=                              # Secret for POST /api/v1/cron/tick/ (empty disables it)
WEBHOOK_SECRET=                           # Secret for POST /api/v1/webhooks/email/ (X-Webhook-Secret header or ?token=; empty disables it)

# === AI personalization of outgoing emails (optional) ===
# none (default, send templates as written) | ollama (self-hosted, free) | gemini
AI_PROVIDER=none
OLLAMA_BASE_URL=http://127.0.0.1:11434    # Where your Ollama server runs
OLLAMA_MODEL=qwen2.5:3b                   # Any model pulled with `ollama pull <name>`
OLLAMA_TIMEOUT_SECONDS=60

# === Gemini AI (only when AI_PROVIDER=gemini) ===
GEMINI_API_KEY=                           # Optional, for AI email generation
GEMINI_MODEL=gemini-3.8-flash             # Optional, override when Google retires a model
# === Django Core ===
SECRET_KEY="django-insecure-change-me"
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# === Backend / Frontend URLs ===
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:8080

# === Google OAuth / Gmail ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

# === Twilio ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# === Celery / Async Jobs ===
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False
LAUNCH_IMMEDIATE_PASSES=0

# === AI / LLM Integrations ===
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-nemo
OPENROUTER_APP_URL=http://localhost:8080
OPENROUTER_APP_NAME=LeadOrbit Campaign Builder
ENABLE_AUTO_REPLY_DETECTION=False

# === Upload Safety ===
MAX_CSV_UPLOAD_SIZE=10485760

